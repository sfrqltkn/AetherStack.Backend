{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Process"
    ],

    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },

    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ],

    "Properties": {
      "ApplicationName": "AetherStack.Backend.WebAPI"
    },

    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/aetherstack-backend-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] [CID:{CorrelationId}] [PID:{ProcessId}] [TID:{ThreadId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5430;Database=AetherStackBackendWebAPI;Username=postgres;Password=sCd06;"
  },

  "JwtSettings": {
    "Issuer": "https://auth.AetherStack-Backend.local",
    "Audience": "https://api.AetherStack-Backend.local",
    "SigningKey": "7wA6qVlzOtXyQX3Fms6M5Eis6HnKz4wCAXvTn/0mopM=",
    "EncryptionKey": "gAkvHYpP6q6Y01L6Yvj9qxjWd/Ea9iP9k8NClJqK3+U=",
    "AccessTokenExpiryMinutes": "15",
    "RefreshTokenExpiryDays": "7"
  },
  "MailSettings": {
    "Host": "-",
    "Port": 587,
    "Username": "-",
    "Password": "-",
    "DisplayName": "AetherStack-Backend",
    "EnableSsl": false,
    "ClientUrl": "https://localhost:7124/scalar/v1",
    "AdminEmail": "sfrqltkn@gmail.com",
    "IgnoreSslErrors": true
  }
}